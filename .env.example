# Environment Variables
# Copy to .env.local and fill in values

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini (for the "Ask AI" chat — optional; the button is hidden without it)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default gemini-flash-latest, which tracks Google's current Flash model)
GEMINI_MODEL=

# Resend (for contact form — optional)
RESEND_API_KEY=
CONTACT_EMAIL=

# Analytics (optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Rate Limiting
CHAT_RATE_LIMIT_PER_MINUTE=10
CONTACT_RATE_LIMIT_PER_HOUR=5
